# ==============================================================================
# Aero-BFF (Symfony 7.4 Gateway) - Variables de Entorno (Desarrollo Local)
# ==============================================================================

# Entorno de Symfony
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=32a8f89c623910c66dbb7c0627581177

# Puerto público del BFF en el host (default: 8000)
BFF_PORT=8000

# Conexión con el Core Backend (Spring Boot 3.3)
# - Si Spring Boot corre en tu máquina (puerto 8080): http://host.docker.internal:8080/api/internal
# - Si Spring Boot corre en un contenedor o servidor remoto: http://<ip-o-host>:8080/api/internal
SPRING_BACKEND_URL=http://host.docker.internal:8080/api/internal

# Secreto interno para autenticación inter-servicios
SPRING_INTERNAL_SECRET=saero-internal-secret-dev-2026

# Configuración CORS para clientes web (Frontend Vue 3)
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
